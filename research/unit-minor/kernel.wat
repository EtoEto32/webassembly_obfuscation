(module
  (memory 2 2)
  (data (i32.const 0) "@DATA@")
  (func $addr (param $i i32) (param $j i32) (param $n i32) (result i32)
    (i32.add (i32.const 65536) (i32.shl (i32.add (i32.mul (local.get $i) (local.get $n)) (local.get $j)) (i32.const 2))))
  (func $get (param $i i32) (param $j i32) (param $n i32) (result i32)
    (i32.load (call $addr (local.get $i) (local.get $j) (local.get $n))))
  (func $put (param $i i32) (param $j i32) (param $n i32) (param $v i32)
    (i32.store (call $addr (local.get $i) (local.get $j) (local.get $n)) (local.get $v)))
  (func $det (param $n i32) (result i32)
    (local $k i32) (local $i i32) (local $j i32) (local $pi i32) (local $pj i32)
    (local $p i32) (local $inv i32) (local $r i32) (local $factor i32) (local $tmp i32) (local $acc i32)
    (local.set $acc (i32.const 1))
    (block $done (loop $pivot
      (br_if $done (i32.ge_u (local.get $k) (i32.sub (local.get $n) (i32.const 1))))
      (local.set $pi (local.get $k))
      (block $found (loop $scanrow
        (if (i32.ge_u (local.get $pi) (local.get $n)) (then unreachable))
        (local.set $pj (local.get $k))
        (block $nextrow (loop $scancol
          (br_if $nextrow (i32.ge_u (local.get $pj) (local.get $n)))
          (br_if $found (i32.and (call $get (local.get $pi) (local.get $pj) (local.get $n)) (i32.const 1)))
          (local.set $pj (i32.add (local.get $pj) (i32.const 1))) (br $scancol)))
        (local.set $pi (i32.add (local.get $pi) (i32.const 1))) (br $scanrow)))
      (if (i32.ne (local.get $pi) (local.get $k)) (then
        (local.set $j (i32.const 0))
        (block $rdone (loop $rswap
          (br_if $rdone (i32.ge_u (local.get $j) (local.get $n)))
          (local.set $tmp (call $get (local.get $k) (local.get $j) (local.get $n)))
          (call $put (local.get $k) (local.get $j) (local.get $n) (call $get (local.get $pi) (local.get $j) (local.get $n)))
          (call $put (local.get $pi) (local.get $j) (local.get $n) (local.get $tmp))
          (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $rswap)))
        (local.set $acc (i32.sub (i32.const 0) (local.get $acc)))))
      (if (i32.ne (local.get $pj) (local.get $k)) (then
        (local.set $i (i32.const 0))
        (block $cdone (loop $cswap
          (br_if $cdone (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $tmp (call $get (local.get $i) (local.get $k) (local.get $n)))
          (call $put (local.get $i) (local.get $k) (local.get $n) (call $get (local.get $i) (local.get $pj) (local.get $n)))
          (call $put (local.get $i) (local.get $pj) (local.get $n) (local.get $tmp))
          (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $cswap)))
        (local.set $acc (i32.sub (i32.const 0) (local.get $acc)))))
      (local.set $p (call $get (local.get $k) (local.get $k) (local.get $n)))
      (local.set $inv (i32.const 1)) (local.set $r (i32.const 0))
      (loop $inverse
        (local.set $inv (i32.mul (local.get $inv) (i32.sub (i32.const 2) (i32.mul (local.get $p) (local.get $inv)))))
        (local.set $r (i32.add (local.get $r) (i32.const 1)))
        (br_if $inverse (i32.lt_u (local.get $r) (i32.const 5))))
      (local.set $acc (i32.mul (local.get $acc) (local.get $p)))
      (local.set $i (i32.add (local.get $k) (i32.const 1)))
      (block $elimdone (loop $elimrow
        (br_if $elimdone (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $factor (i32.mul (call $get (local.get $i) (local.get $k) (local.get $n)) (local.get $inv)))
        (local.set $j (local.get $k))
        (block $rowdone (loop $elimcol
          (br_if $rowdone (i32.ge_u (local.get $j) (local.get $n)))
          (call $put (local.get $i) (local.get $j) (local.get $n)
            (i32.sub (call $get (local.get $i) (local.get $j) (local.get $n))
              (i32.mul (local.get $factor) (call $get (local.get $k) (local.get $j) (local.get $n)))))
          (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $elimcol)))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $elimrow)))
      (local.set $k (i32.add (local.get $k) (i32.const 1))) (br $pivot)))
    (i32.mul (local.get $acc) (call $get (local.get $k) (local.get $k) (local.get $n))))
  (func (export "run") (param $x i32) (param $y i32) (param $z i32) (result i32)
    (local $n i32) (local $count i32) (local $i i32) (local $ptr i32)
    (local $term i32) (local $v i32) (local $e i32) (local $axis i32) (local $at i32)
    (i32.store (i32.const 32) (local.get $x))
    (i32.store (i32.const 36) (local.get $y))
    (i32.store (i32.const 40) (local.get $z))
    (local.set $n (i32.load (i32.const 4)))
    (local.set $count (i32.load (i32.const 8)))
    (block $cleared (loop $clear
      (br_if $cleared (i32.ge_u (local.get $i) (i32.mul (local.get $n) (local.get $n))))
      (i32.store (i32.add (i32.const 65536) (i32.shl (local.get $i) (i32.const 2))) (i32.const 0))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $clear)))
    (local.set $i (i32.const 0)) (local.set $ptr (i32.const 256))
    (block $built (loop $record
      (br_if $built (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $term (i32.load offset=4 (local.get $ptr))) (local.set $axis (i32.const 0))
      (loop $axes
        (local.set $e (i32.load (i32.add (local.get $ptr) (i32.add (i32.const 8) (i32.shl (local.get $axis) (i32.const 2))))))
        (local.set $v (i32.load (i32.add (i32.const 32) (i32.shl (local.get $axis) (i32.const 2)))))
        (block $powerdone (loop $power
          (br_if $powerdone (i32.eqz (local.get $e)))
          (local.set $term (i32.mul (local.get $term) (local.get $v)))
          (local.set $e (i32.sub (local.get $e) (i32.const 1))) (br $power)))
        (local.set $axis (i32.add (local.get $axis) (i32.const 1)))
        (br_if $axes (i32.lt_u (local.get $axis) (i32.const 3))))
      (local.set $at (i32.add (i32.const 65536) (i32.shl (i32.load (local.get $ptr)) (i32.const 2))))
      (i32.store (local.get $at) (i32.add (i32.load (local.get $at)) (local.get $term)))
      (local.set $ptr (i32.add (local.get $ptr) (i32.const 20)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $record)))
    (call $det (local.get $n)))
)

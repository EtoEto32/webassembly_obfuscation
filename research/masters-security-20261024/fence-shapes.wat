(component
  (import "research:shapes/storage" (instance $host
    (export "file" (type $f (sub resource)))
    (type $b (borrow $f))
    (type $o (option $b))
    (type $oo (option $o))
    (type $list (list $o))
    (type $r (record (field "first-file" $b) (field "nested" $oo) (field "batches" $list)))
    (export "request" (type $request (eq $r)))
    (export "open" (func (param "id" u32) (result (own $f))))
    (export "prepare" (func (param "value" $request) (result u32)))))
  (alias export $host "file" (type $file))
  (alias export $host "open" (func $open))
  (alias export $host "prepare" (func $prepare))
  (core module $data (memory (export "memory") 1))
  (core instance $mem (instantiate $data))
  (core func $open-core (canon lower (func $open)))
  (core func $prepare-core (canon lower (func $prepare) (memory $mem "memory")))
  (core func $drop-core (canon resource.drop $file))
  (core module $guest
    (import "i" "memory" (memory 1))
    (import "i" "open" (func $open (param i32) (result i32)))
    (import "i" "prepare" (func $prepare (param i32 i32 i32 i32 i32 i32) (result i32)))
    (import "i" "drop" (func $drop (param i32)))
    (global $a (mut i32) (i32.const 0)) (global $b (mut i32) (i32.const 0))
    (func (export "setup") (param i32 i32)
      (global.set $a (call $open (local.get 0))) (global.set $b (call $open (local.get 1))))
    (func (export "release") (call $drop (global.get $a)) (call $drop (global.get $b)))
    (func (export "request") (param $nested i32) (param $count i32) (result i32) (local $i i32)
      (if (i32.or (i32.gt_u (local.get $nested) (i32.const 2)) (i32.gt_u (local.get $count) (i32.const 8))) (then unreachable))
      (block $done (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        (i32.store8 (i32.mul (local.get $i) (i32.const 8)) (i32.ne (i32.rem_u (local.get $i) (i32.const 3)) (i32.const 0)))
        (i32.store offset=4 (i32.mul (local.get $i) (i32.const 8))
          (select (global.get $b) (global.get $a) (i32.and (local.get $i) (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop)))
      (call $prepare (global.get $a) (i32.ne (local.get $nested) (i32.const 0))
        (i32.eq (local.get $nested) (i32.const 2)) (global.get $b) (i32.const 0) (local.get $count))))
  (core instance $i (export "memory" (memory $mem "memory")) (export "open" (func $open-core))
    (export "prepare" (func $prepare-core)) (export "drop" (func $drop-core)))
  (core instance $g (instantiate $guest (with "i" (instance $i))))
  (func (export "setup") (param "a" u32) (param "b" u32) (canon lift (core func $g "setup")))
  (func (export "release") (canon lift (core func $g "release")))
  (func (export "request") (param "nested" u32) (param "count" u32) (result u32) (canon lift (core func $g "request"))))

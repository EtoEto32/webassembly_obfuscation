(component
  (import "research:fence/storage" (instance $host
    (export "file" (type $f (sub resource)))
    (type $b (borrow $f))
    (type $pair (record (field "source" $b) (field "destination" $b)))
    (export "pair" (type $pair-out (eq $pair)))
    (type $ls (list $b))
    (type $op (option $b))
    (type $optional (record (field "primary" $b) (field "backup" $op)))
    (export "optional-write" (type $optional-out (eq $optional)))
    (type $request (variant (case "read" $b) (case "write" $b)
      (case "copy" $pair-out) (case "batch" $ls) (case "optional" $optional-out) (case "idle")))
    (export "request" (type $request-out (eq $request)))
    (export "open" (func (param "id" u32) (result (own $f))))
    (export "prepare" (func (param "value" $request-out) (result u32)))))
  (alias export $host "file" (type $file))
  (alias export $host "open" (func $open))
  (alias export $host "prepare" (func $prepare))
  (core module $data (memory (export "memory") 1))
  (core instance $mem (instantiate $data))
  (core func $open-core (canon lower (func $open)))
  (core func $prepare-core (canon lower (func $prepare) (memory $mem "memory")))
  (core func $drop-core (canon resource.drop $file))
  (core module $guest
    (import "i" "memory" (memory 1))
    (import "i" "open" (func $open (param i32) (result i32)))
    (import "i" "prepare" (func $prepare (param i32 i32 i32 i32) (result i32)))
    (import "i" "drop" (func $drop (param i32)))
    (global $a (mut i32) (i32.const 0))
    (global $b (mut i32) (i32.const 0))
    (func (export "setup") (param $a-id i32) (param $b-id i32)
      (global.set $a (call $open (local.get $a-id)))
      (global.set $b (call $open (local.get $b-id))))
    (func (export "release")
      (call $drop (global.get $a)) (call $drop (global.get $b)))
    (func (export "request") (param $mode i32) (param $count i32) (result i32) (local $i i32)
      (if (i32.gt_u (local.get $count) (i32.const 64)) (then unreachable))
      (block $done (loop $fill
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        (i32.store (i32.mul (local.get $i) (i32.const 4))
          (select (global.get $a) (global.get $b) (i32.eqz (i32.and (local.get $i) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $fill)))
      (if (i32.lt_u (local.get $mode) (i32.const 2)) (then
        (return (call $prepare (local.get $mode) (global.get $a) (i32.const 0) (i32.const 0)))))
      (if (i32.eq (local.get $mode) (i32.const 2)) (then
        (return (call $prepare (local.get $mode) (global.get $a) (global.get $b) (i32.const 0)))))
      (if (i32.eq (local.get $mode) (i32.const 3)) (then
        (return (call $prepare (local.get $mode) (i32.const 0) (local.get $count) (i32.const 0)))))
      (if (i32.eq (local.get $mode) (i32.const 4)) (then
        (return (call $prepare (local.get $mode) (global.get $a)
          (i32.ne (local.get $count) (i32.const 0)) (global.get $b)))))
      (call $prepare (local.get $mode) (i32.const 0) (i32.const 0) (i32.const 0)))
  )
  (core instance $i
    (export "memory" (memory $mem "memory"))
    (export "open" (func $open-core))
    (export "prepare" (func $prepare-core))
    (export "drop" (func $drop-core)))
  (core instance $g (instantiate $guest (with "i" (instance $i))))
  (func (export "setup") (param "a-id" u32) (param "b-id" u32) (canon lift (core func $g "setup")))
  (func (export "release") (canon lift (core func $g "release")))
  (func (export "request") (param "mode" u32) (param "count" u32) (result u32) (canon lift (core func $g "request"))))

(component
 (type $bytes (list u8)) (type $row (list $bytes)) (type $matrix (list $row))
 (import "consume" (func $consume (param "value" $matrix) (result u32)))
 (core module $memory (memory (export "memory") 1))
 (core instance $mem (instantiate $memory))
 (core func $consume-core (canon lower (func $consume) (memory $mem "memory")))
 (core module $guest
  (import "env" "memory" (memory 1))
  (import "env" "consume" (func $consume (param i32 i32) (result i32)))
  (func (export "run") (param $width i32) (param $count i32) (param $size i32) (param $shared i32) (result i32)
   (local $i i32) (local $j i32) (local $row i32) (local $leaf i32)
   (if (i32.or (i32.gt_u (local.get $width) (i32.const 32)) (i32.gt_u (local.get $count) (i32.const 32))) (then unreachable))
   (if (i32.gt_u (local.get $size) (i32.const 512)) (then unreachable))
   (if (i32.eqz (local.get $shared)) (then
    (if (i32.gt_u (i32.mul (i32.mul (local.get $width) (local.get $count)) (local.get $size)) (i32.const 49152)) (then unreachable))))
   (memory.fill (i32.const 16384) (i32.const 7) (i32.const 49152))
   (block $end (loop $outer
    (br_if $end (i32.ge_u (local.get $i) (local.get $width)))
    (local.set $row (i32.add (i32.const 1024) (select (i32.const 0) (i32.mul (local.get $i) (i32.const 256)) (local.get $shared))))
    (i32.store (i32.mul (local.get $i) (i32.const 8)) (local.get $row))
    (i32.store offset=4 (i32.mul (local.get $i) (i32.const 8)) (local.get $count))
    (local.set $j (i32.const 0))
    (block $row-end (loop $inner
     (br_if $row-end (i32.ge_u (local.get $j) (local.get $count)))
     (local.set $leaf (i32.add (i32.const 16384) (select (i32.const 0)
      (i32.mul (i32.add (i32.mul (local.get $i) (local.get $count)) (local.get $j)) (local.get $size)) (local.get $shared))))
     (i32.store (i32.add (local.get $row) (i32.mul (local.get $j) (i32.const 8))) (local.get $leaf))
     (i32.store offset=4 (i32.add (local.get $row) (i32.mul (local.get $j) (i32.const 8))) (local.get $size))
     (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $inner)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $outer)))
   (call $consume (i32.const 0) (local.get $width))))
 (core instance $env (export "memory" (memory $mem "memory")) (export "consume" (func $consume-core)))
 (core instance $g (instantiate $guest (with "env" (instance $env))))
 (func (export "run") (param "width" u32) (param "count" u32) (param "size" u32) (param "shared" u32) (result u32)
  (canon lift (core func $g "run"))))

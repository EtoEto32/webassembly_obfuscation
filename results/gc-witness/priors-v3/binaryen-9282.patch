From 196b322d417fed526afb67c9d128c9592579138b Mon Sep 17 00:00:00 2001
From: Thomas Lively <tlively@google.com>
Date: Mon, 19 Oct 2026 19:25:41 -0700
Subject: [PATCH 1/5] [Fuzzer] Handle uninhabitable types in makeCompoundRef

Uninhabitable heap types from the initial module are filtered out of interestingHeapTypes in setupHeapTypes, but inhabitable types in interestingHeapTypes (as well as initial module globals and functions) can still reference them. Track uninhabitableHeapTypes in TranslateToFuzzReader and check for them in makeCompoundRef, getSubType, and getSuperType so makeCompoundRef emits ref.null, local.get, or ref.as_non_null rather than infinitely recursing across non-nullable type cycles.
---
 src/tools/fuzzing.h              |  4 ++++
 src/tools/fuzzing/fuzzing.cpp    | 34 +++++++++++++++++++++++++-------
 test/lit/fuzz-uninhabitable.wast | 25 +++++++++++++++++++++++
 3 files changed, 56 insertions(+), 7 deletions(-)
 create mode 100644 test/lit/fuzz-uninhabitable.wast

diff --git a/src/tools/fuzzing.h b/src/tools/fuzzing.h
index 2bd3d7761c3..c0e25520096 100644
--- a/src/tools/fuzzing.h
+++ b/src/tools/fuzzing.h
@@ -212,6 +212,9 @@ class TranslateToFuzzReader {
   // The heap types we can pick from to generate instructions.
   std::vector<HeapType> interestingHeapTypes;
 
+  // Heap types from initial content that cannot be constructed.
+  std::unordered_set<HeapType> uninhabitableHeapTypes;
+
   // A mapping of a heap type to the subset of interestingHeapTypes that are
   // subtypes of it.
   std::unordered_map<HeapType, std::vector<HeapType>> interestingHeapSubTypes;
@@ -584,6 +587,7 @@ class TranslateToFuzzReader {
   Type getStorableType();
   Type getLoggableType();
   bool isLoggableType(Type type);
+  bool isUninhabitable(Type type);
   Nullability getNullability();
   Exactness getExactness();
   Nullability getSubType(Nullability nullability);
diff --git a/src/tools/fuzzing/fuzzing.cpp b/src/tools/fuzzing/fuzzing.cpp
index c202c210d7e..03af38d8a1e 100644
--- a/src/tools/fuzzing/fuzzing.cpp
+++ b/src/tools/fuzzing/fuzzing.cpp
@@ -546,6 +546,13 @@ void TranslateToFuzzReader::setupHeapTypes() {
   // Filter away uninhabitable heap types, that is, heap types that we cannot
   // construct, like a type with a non-nullable reference to itself.
   interestingHeapTypes = HeapTypeGenerator::getInhabitable(possibleHeapTypes);
+  std::unordered_set<HeapType> inhabitable(interestingHeapTypes.begin(),
+                                           interestingHeapTypes.end());
+  for (auto type : possibleHeapTypes) {
+    if (!inhabitable.contains(type)) {
+      uninhabitableHeapTypes.insert(type);
+    }
+  }
 
   // For GC, also generate random types.
   if (wasm.features.hasGC()) {
@@ -4524,8 +4531,9 @@ Expression* TranslateToFuzzReader::makeCompoundRef(Type type) {
   // inhabitable.)
   const auto LIMIT = fuzzParams.NESTING_LIMIT + 1;
   AutoNester nester(*this);
-  if (type.isNullable() &&
-      (random.finished() || nesting >= LIMIT || oneIn(LIMIT - nesting + 1))) {
+  if (type.isNullable() && (random.finished() || nesting >= LIMIT ||
+                            uninhabitableHeapTypes.contains(heapType) ||
+                            oneIn(LIMIT - nesting + 1))) {
     return builder.makeRefNull(heapType);
   }
 
@@ -4533,7 +4541,8 @@ Expression* TranslateToFuzzReader::makeCompoundRef(Type type) {
   // something here to avoid infinite recursion. In the worse case we'll emit a
   // cast to non-null of a null, which validates, but it will trap at runtime
   // which is not ideal.
-  if (type.isNonNullable() && (random.finished() || nesting >= LIMIT)) {
+  if (type.isNonNullable() && (random.finished() || nesting >= LIMIT ||
+                               uninhabitableHeapTypes.contains(heapType))) {
     // If we have a function context then we can at least emit a local.get,
     // sometimes, which is less bad. Note that we need to check typeLocals
     // manually here to avoid infinite recursion (as makeLocalGet will fall back
@@ -4547,7 +4556,12 @@ Expression* TranslateToFuzzReader::makeCompoundRef(Type type) {
       return builder.makeRefAs(RefAsNonNull, builder.makeRefNull(heapType));
     }
     // No function context, so we are in quite the pickle. Continue onwards, as
-    // we may succeed to emit something more complex (like a struct.new).
+    // we may succeed to emit something more complex (like a struct.new). If the
+    // type is uninhabitable, though, use the ref.as_non_null escape hatch
+    // immediately.
+    if (uninhabitableHeapTypes.contains(heapType)) {
+      return builder.makeRefAs(RefAsNonNull, builder.makeRefNull(heapType));
+    }
   }
 
   // When we make children, they must be trivial if we are not in a function
@@ -6866,6 +6880,12 @@ bool TranslateToFuzzReader::isLoggableType(Type type) {
          loggableTypes.end();
 }
 
+bool TranslateToFuzzReader::isUninhabitable(Type type) {
+  return GCTypeUtils::isUninhabitable(type) ||
+         (type.isRef() && type.isNonNullable() &&
+          uninhabitableHeapTypes.contains(type.getHeapType()));
+}
+
 Nullability TranslateToFuzzReader::getNullability() {
   // Without wasm GC, avoid non-nullable types as we cannot create any values
   // of such types. For example, reference types adds eqref, but there is no
@@ -7022,8 +7042,8 @@ Type TranslateToFuzzReader::getSubType(Type type) {
     // inhabitable then return that; avoid adding more uninhabitability. We can
     // never add new uninhabitability outside of functions, where we cannot
     // use casts to generate something valid.
-    if (GCTypeUtils::isUninhabitable(subType) &&
-        !GCTypeUtils::isUninhabitable(type) && (!funcContext || !oneIn(20))) {
+    if (isUninhabitable(subType) && !isUninhabitable(type) &&
+        (!funcContext || !oneIn(20))) {
       return type;
     }
     return subType;
@@ -7090,7 +7110,7 @@ Type TranslateToFuzzReader::getSuperType(Type type) {
   auto superType = Type(heapType, nullability);
   // As with getSubType, we want to avoid returning an uninhabitable type where
   // possible. Here all we can do is flip the super's nullability to nullable.
-  if (GCTypeUtils::isUninhabitable(superType)) {
+  if (isUninhabitable(superType)) {
     superType = Type(heapType, Nullable);
   }
   return superType;
diff --git a/test/lit/fuzz-uninhabitable.wast b/test/lit/fuzz-uninhabitable.wast
new file mode 100644
index 00000000000..12f9c4d9497
--- /dev/null
+++ b/test/lit/fuzz-uninhabitable.wast
@@ -0,0 +1,25 @@
+;; Test that translate-to-fuzz handles uninhabitable types in initial module
+;; contents without infinitely recursing in makeCompoundRef.
+
+;; RUN: wasm-opt %s -all -ttf --initial-fuzz=%s -S -o - | filecheck %s
+
+(module
+ (rec
+  (type $0 (descriptor $1) (struct))
+  (type $1 (describes $0) (struct (field (ref (exact $0)))))
+ )
+ (type $2 (struct (field (ref struct)) (field (ref null (exact $0)))))
+ (global $g (import "a" "b") (ref $2))
+ (func $f1 (import "a" "c") (result (ref $0)))
+ (func $f2 (import "a" "d") (param (ref $0)) (result (ref $0)))
+ (func $f3 (import "a" "e") (result (ref $0)))
+)
+
+;; CHECK:      (global $g (ref $2) (struct.new $2
+;; CHECK-NEXT:  (struct.new{{.*}})
+;; CHECK-NEXT:  (ref.null none)
+;; CHECK-NEXT: ))
+
+;; CHECK:      (func $f1 (type ${{.*}}) (result (ref $0))
+;; CHECK:      (func $f2 (type ${{.*}}) (param $0 (ref $0)) (result (ref $0))
+;; CHECK:      (func $f3 (type ${{.*}}) (result (ref $0))


diff --git a/src/ir/gc-type-utils.h b/src/ir/gc-type-utils.h
index f46b1b97179..393a48915fb 100644
--- a/src/ir/gc-type-utils.h
+++ b/src/ir/gc-type-utils.h
@@ -21,7 +21,8 @@
 
 namespace wasm::GCTypeUtils {
 
-inline bool isUninhabitable(Type type) {
+inline bool isTriviallyUninhabitable(Type type) {
+  // TODO: Include non-shared waitqueue.
   return type.isNonNullable() && type.getHeapType().isBottom();
 }
 
@@ -77,7 +78,7 @@ inline EvaluationResult evaluateCastCheck(Type refType, Type castType) {
     return Unknown;
   }
 
-  if (isUninhabitable(refType)) {
+  if (isTriviallyUninhabitable(refType)) {
     // No value can appear in the ref, so the cast cannot be reached.
     return Unreachable;
   }
diff --git a/src/tools/fuzzing/fuzzing.cpp b/src/tools/fuzzing/fuzzing.cpp
index 03af38d8a1e..d100d3eb660 100644
--- a/src/tools/fuzzing/fuzzing.cpp
+++ b/src/tools/fuzzing/fuzzing.cpp
@@ -6881,7 +6881,7 @@ bool TranslateToFuzzReader::isLoggableType(Type type) {
 }
 
 bool TranslateToFuzzReader::isUninhabitable(Type type) {
-  return GCTypeUtils::isUninhabitable(type) ||
+  return GCTypeUtils::isTriviallyUninhabitable(type) ||
          (type.isRef() && type.isNonNullable() &&
           uninhabitableHeapTypes.contains(type.getHeapType()));
 }


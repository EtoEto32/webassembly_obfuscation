@@ -70,6 +70,20 @@
       "filename": "very-nested.9.wasm",
       "module_type": "binary",
       "text": "type nesting is too deep"
+    },
+    {
+      "type": "module",
+      "line": 2522,
+      "name": "c",
+      "filename": "very-nested.10.wasm",
+      "module_type": "binary"
+    },
+    {
+      "type": "assert_invalid",
+      "line": 2545,
+      "filename": "very-nested.11.wasm",
+      "module_type": "binary",
+      "text": "effective type size exceeds the limit"
     }
   ]
 }
\ No newline at end of file
diff --git a/tests/snapshots/cli/component-model/very-nested.wast/10.print b/tests/snapshots/cli/component-model/very-nested.wast/10.print
new file mode 100644
index 0000000000..5224fe2e3f
--- /dev/null
+++ b/tests/snapshots/cli/component-model/very-nested.wast/10.print
@@ -0,0 +1,22 @@
+(component $c
+  (type $t0 (;0;) (tuple u32 u32 u32 u32 u32 u32 u32 u32))
+  (type $t1 (;1;) (tuple $t0 $t0))
+  (type $t2 (;2;) (tuple $t1 $t1))
+  (type $t3 (;3;) (tuple $t2 $t2))
+  (type $t4 (;4;) (tuple $t3 $t3))
+  (type $t5 (;5;) (tuple $t4 $t4))
+  (type $t6 (;6;) (tuple $t5 $t5))
+  (type $t7 (;7;) (tuple $t6 $t6))
+  (type $t8 (;8;) (tuple $t7 $t7))
+  (type $t9 (;9;) (tuple $t8 $t8))
+  (type $t10 (;10;) (tuple $t9 $t9))
+  (type $t11 (;11;) (tuple $t10 $t10))
+  (type $t12 (;12;) (tuple $t11 $t11))
+  (type $t13 (;13;) (tuple $t12 $t12))
+  (type $t14 (;14;) (tuple $t13 $t13))
+  (type $t15 (;15;) (tuple $t14 $t14))
+  (type $t16 (;16;) (tuple $t15 $t15))
+  (component (;0;)
+    (alias outer $c $t16 (type (;0;)))
+  )
+)

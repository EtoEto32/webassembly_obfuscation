From 149592703e8220d264129b5da23e443b9e1150a7 Mon Sep 17 00:00:00 2001
From: Alex Crichton <alex@alexcrichton.com>
Date: Tue, 6 Oct 2026 08:49:30 -0700
Subject: [PATCH] Fix an exponential algorithm validating components

When processing outer aliases in a component the type being aliased
needs to be searched for free variables to handle resources correctly,
and this traversal takes `O(size)` where `size` is the overall size of
the type. This size is bounded for imports/exports of a component, but
otherwise not bounded for anything within a component. The fix here is
to track this size bound for component-internal types and outer aliases
to account for work performed, and the limit is the same as that which
is used for exports/imports.
---
 crates/wasmparser/src/validator/component.rs  | 21 +++++++-
 tests/cli/component-model/very-nested.wast    | 51 +++++++++++++++++++
 .../cli/component-model/very-nested.wast.json | 14 +++++
 .../component-model/very-nested.wast/10.print | 22 ++++++++
 4 files changed, 106 insertions(+), 2 deletions(-)
 create mode 100644 tests/snapshots/cli/component-model/very-nested.wast/10.print

diff --git a/crates/wasmparser/src/validator/component.rs b/crates/wasmparser/src/validator/component.rs
index df4b388e9d..06f39cc647 100644
--- a/crates/wasmparser/src/validator/component.rs
+++ b/crates/wasmparser/src/validator/component.rs
@@ -1,7 +1,7 @@
 //! State relating to validating a WebAssembly component.
 
 use super::{
-    check_max,
+    check_max, combine_type_sizes,
     component_types::{
         Abi, AbiInfo, AliasableResourceId, ComponentAnyTypeId, ComponentCoreInstanceTypeId,
         ComponentCoreModuleTypeId, ComponentCoreTypeId, ComponentDefinedType,
@@ -69,6 +69,13 @@ pub(crate) struct ComponentState {
     has_start: bool,
     type_info: TypeInfo,
 
+    /// The total size of all types which have been outer-aliased into this
+    /// component from an enclosing component.
+    ///
+    /// Such aliases require a walk over the aliased type to check it for
+    /// resources, so this is used to bound the total amount of work done.
+    outer_alias_type_size: u32,
+
     /// A mapping of imported resources in this component.
     ///
     /// This mapping represents all "type variables" imported into the
@@ -485,6 +492,7 @@ impl ComponentState {
             export_names: Default::default(),
             has_start: Default::default(),
             type_info: TypeInfo::new(),
+            outer_alias_type_size: 0,
             imported_resources: Default::default(),
             defined_resources: Default::default(),
             explicit_resources: Default::default(),
@@ -3968,9 +3976,18 @@ impl ComponentState {
         // the target is either a type or a component, both of which are valid
         // (as aliases can reach the enclosing component and have as many free
         // variables as they want).
+        //
+        // Note that the free variables check is proportional to the size of
+        // `ty`, so the size of `ty` is charged to the component that the
+        // alias crosses into to bound the total amount of work done.
         let pos_after_component = components.len() - (count as usize);
-        if let Some(component) = components.get(pos_after_component) {
+        if let Some(component) = components.get_mut(pos_after_component) {
             if component.kind == ComponentKind::Component {
+                component.outer_alias_type_size = combine_type_sizes(
+                    component.outer_alias_type_size,
+                    ty.info(types).size(),
+                    offset,
+                )?;
                 let mut free = IndexSet::default();
                 types.free_variables_any_type_id(ty, &mut free);
                 if !free.is_empty() {
diff --git a/tests/cli/component-model/very-nested.wast b/tests/cli/component-model/very-nested.wast
index 1ca9c0720a..d37d940c4f 100644
--- a/tests/cli/component-model/very-nested.wast
+++ b/tests/cli/component-model/very-nested.wast
@@ -2515,3 +2515,54 @@
     (type $i130 (instance (export "i" (instance (type $i129)))))
   )
   "type nesting is too deep")
+
+;; Outer aliases of types across a component boundary are charged against a
+;; per-component type size budget, as the aliased type must be checked for
+;; resources.
+(component $c
+  (type $t0 (tuple u32 u32 u32 u32 u32 u32 u32 u32))
+  (type $t1 (tuple $t0 $t0))
+  (type $t2 (tuple $t1 $t1))
+  (type $t3 (tuple $t2 $t2))
+  (type $t4 (tuple $t3 $t3))
+  (type $t5 (tuple $t4 $t4))
+  (type $t6 (tuple $t5 $t5))
+  (type $t7 (tuple $t6 $t6))
+  (type $t8 (tuple $t7 $t7))
+  (type $t9 (tuple $t8 $t8))
+  (type $t10 (tuple $t9 $t9))
+  (type $t11 (tuple $t10 $t10))
+  (type $t12 (tuple $t11 $t11))
+  (type $t13 (tuple $t12 $t12))
+  (type $t14 (tuple $t13 $t13))
+  (type $t15 (tuple $t14 $t14))
+  (type $t16 (tuple $t15 $t15))
+  (component
+    (alias outer $c $t16 (type))
+  )
+)
+(assert_invalid
+  (component $c
+    (type $t0 (tuple u32 u32 u32 u32 u32 u32 u32 u32))
+    (type $t1 (tuple $t0 $t0))
+    (type $t2 (tuple $t1 $t1))
+    (type $t3 (tuple $t2 $t2))
+    (type $t4 (tuple $t3 $t3))
+    (type $t5 (tuple $t4 $t4))
+    (type $t6 (tuple $t5 $t5))
+    (type $t7 (tuple $t6 $t6))
+    (type $t8 (tuple $t7 $t7))
+    (type $t9 (tuple $t8 $t8))
+    (type $t10 (tuple $t9 $t9))
+    (type $t11 (tuple $t10 $t10))
+    (type $t12 (tuple $t11 $t11))
+    (type $t13 (tuple $t12 $t12))
+    (type $t14 (tuple $t13 $t13))
+    (type $t15 (tuple $t14 $t14))
+    (type $t16 (tuple $t15 $t15))
+    (component
+      (alias outer $c $t16 (type))
+      (alias outer $c $t16 (type))
+    )
+  )
+  "effective type size exceeds the limit")

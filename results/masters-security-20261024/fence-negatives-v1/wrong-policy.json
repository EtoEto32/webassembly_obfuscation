{
  "interface": "storage",
  "function": "prepare",
  "argument": "value",
  "permissions": {
    "value/@read": "read",
    "value/@write": "write",
    "value/@copy/source": "read",
    "value/@copy/destination": "read",
    "value/@batch/*": "write",
    "value/@optional/primary": "write",
    "value/@optional/backup/?": "write"
  }
}
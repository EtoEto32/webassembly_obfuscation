{
  "chain": [
    {
      "read": "$value.initial",
      "as": "initial"
    },
    {
      "for": "$value.copies",
      "as": "item",
      "body": [
        {
          "read": "$item.source-file",
          "as": "local"
        },
        {
          "write": "$item.target-file",
          "from": "local"
        }
      ]
    },
    {
      "ifSome": "$value.backup",
      "as": "backup",
      "body": [
        {
          "write": "$backup",
          "from": "initial"
        },
        {
          "write": "$backup",
          "literal": "x\u0000z"
        }
      ]
    }
  ],
  "matrix": [
    {
      "for": "$value",
      "as": "row",
      "body": [
        {
          "for": "$row",
          "as": "item",
          "body": [
            {
              "read": "$item.source-file",
              "as": "data"
            },
            {
              "write": "$item.target-file",
              "from": "data"
            }
          ]
        }
      ]
    }
  ],
  "optional": [
    {
      "ifSome": "$value",
      "as": "item",
      "body": [
        {
          "read": "$item.source-file",
          "as": "data"
        },
        {
          "write": "$item.target-file",
          "from": "data"
        }
      ]
    }
  ]
}
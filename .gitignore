# Generated by Cargo
# will have compiled files and executables
debug
target

# Acquired/generated research data and local tool environments
data/
.venv/
.tools/
node_modules/
experiments/runtime-reference/pool-config.local.json
__pycache__/

# Local TensorFlow environment and runtime credentials
.tf/
experiments/runtime-reference/fastpool-user.json

# Historical paper backups and compiler intermediates
paper/revisions/
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# Downloaded source mirrors and temporary inspection artifacts
tmp/**/source/
tmp/**/source-text/
tmp/**/artifacts/
tmp/**/*.pdf
tmp/**/*.zip
tmp/**/*.html
tmp/document-path-index-*/

# Large regenerated corpus tables, disassemblies and runtime dumps
results/corpus/*.csv
results/corpus/runs/
results/**/*.jsonl
results/**/*.wat
results/**/*.wasm
results/cases/*/disassembly.txt
results/cases/*/excerpts.txt
results/provenance/cryptic-bytes-parent-evidence.json
results/provenance/cryptic-bytes-parents.csv
results/provenance/cryptic-bytes-feature-pairs.csv
results/runtime-mining/cross-dataset/mining-candidates.csv
results/runtime-mining/cross-dataset/proof-of-theft/runtime-roles.json
results/mining-methods/pair-metrics.csv
results/mining-methods/input-manifest.csv

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

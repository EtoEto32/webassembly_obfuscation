(module
(func (export "run") (param $x0 i32)(param $x1 i32)(param $u i32)(param $n i32)(result i32 i32)
(local $c i32)(local $t0 i32)(local $t1 i32)
(local.set $n (i32.and (local.get $n)(i32.const 31)))
(block $exit (loop $loop
(br_if $exit (i32.eqz (local.get $n)))
(local.set $c (select (i32.const 3)(i32.const 5)(i32.and (i32.add (local.get $x1) (local.get $x0))(i32.const 1))))
(local.set $t0 (i32.add (i32.add (local.get $u) (i32.mul (local.get $x0) (local.get $c))) (i32.mul (local.get $x0) (local.get $x0))))
(local.set $t1 (i32.add (i32.add (local.get $u) (i32.mul (local.get $x1) (local.get $c))) (i32.mul (local.get $x1) (local.get $x1))))
(local.set $x0 (local.get $t0))
(local.set $x1 (local.get $t1))
(local.set $n (i32.sub (local.get $n)(i32.const 1)))
(br $loop)))
(i32.add (local.get $x1) (local.get $x0))
(i32.mul (local.get $x0) (local.get $x1))
))
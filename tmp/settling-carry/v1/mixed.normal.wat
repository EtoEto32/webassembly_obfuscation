(module (func (export "run") (param $x i32) (param $y i32) (param $u i32) (result i32)
(local $round i32) (local $j i32) (local $i i32)
(local $s0 i32) (local $c0 i32) (local $s1 i32) (local $c1 i32) (local $s2 i32) (local $c2 i32) (local $s3 i32) (local $c3 i32) (local $s4 i32) (local $c4 i32)
(local.set $s0 (i32.add (local.get $x) (local.get $y)))
(local.set $s1 (i32.mul (local.get $s0) (local.get $x)))
(local.set $s2 (i32.add (local.get $s1) (local.get $y)))
(local.set $s3 (i32.rotl (local.get $x) (i32.const 7)))
(local.set $s4 (i32.xor (local.get $s2) (local.get $s3)))
(local.get $s4) ))
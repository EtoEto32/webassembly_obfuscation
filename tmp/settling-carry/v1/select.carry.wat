(module (func (export "run") (param $x i32) (param $y i32) (param $u i32) (result i32)
(local $round i32) (local $j i32) (local $i i32)
(local $s0 i32) (local $c0 i32) (local $s1 i32) (local $c1 i32) (local $s2 i32) (local $c2 i32) (local $s3 i32) (local $c3 i32) (local $s4 i32) (local $c4 i32) (local $s5 i32) (local $c5 i32)
(local.set $s0 (i32.xor (local.get $u) (i32.const 7)))
(local.set $c0 (i32.xor (local.get $u) (i32.const 11)))
(local.set $s1 (i32.xor (local.get $u) (i32.const 20)))
(local.set $c1 (i32.xor (local.get $u) (i32.const 30)))
(local.set $s2 (i32.xor (local.get $u) (i32.const 33)))
(local.set $c2 (i32.xor (local.get $u) (i32.const 49)))
(local.set $s3 (i32.xor (local.get $u) (i32.const 46)))
(local.set $c3 (i32.xor (local.get $u) (i32.const 68)))
(local.set $s4 (i32.xor (local.get $u) (i32.const 59)))
(local.set $c4 (i32.xor (local.get $u) (i32.const 87)))
(local.set $s5 (i32.xor (local.get $u) (i32.const 72)))
(local.set $c5 (i32.xor (local.get $u) (i32.const 106)))
(loop $sweeps
(local.set $i (i32.rem_u (i32.xor (local.get $u) (local.get $s0)) (i32.const 6)))
(local.set $j (i32.const 0)) (loop $visit
(if (i32.eq (local.get $i) (i32.const 0)) (then (local.set $s0 (i32.xor (i32.xor (local.get $x) (local.get $y)) (local.get $c0)))
    (local.set $c0 (i32.shl (i32.or (i32.and (local.get $x) (local.get $y)) (i32.and (i32.xor (local.get $x) (local.get $y)) (local.get $c0))) (i32.const 1)))))
(if (i32.eq (local.get $i) (i32.const 1)) (then (local.set $s1 (i32.rotl (local.get $x) (i32.const 3)))))
(if (i32.eq (local.get $i) (i32.const 2)) (then (local.set $s2 (i32.mul (local.get $s0) (local.get $s1)))))
(if (i32.eq (local.get $i) (i32.const 3)) (then (local.set $s3 (i32.xor (i32.xor (local.get $s2) (local.get $y)) (local.get $c3)))
    (local.set $c3 (i32.shl (i32.or (i32.and (local.get $s2) (local.get $y)) (i32.and (i32.xor (local.get $s2) (local.get $y)) (local.get $c3))) (i32.const 1)))))
(if (i32.eq (local.get $i) (i32.const 4)) (then (local.set $s4 (i32.lt_u (local.get $s2) (local.get $s3)))))
(if (i32.eq (local.get $i) (i32.const 5)) (then (local.set $s5 (select (local.get $s0) (local.get $s3) (local.get $s4)))))
(local.set $i (i32.rem_u (i32.add (local.get $i) (i32.const 1)) (i32.const 6)))
(local.set $j (i32.add (local.get $j) (i32.const 1)))
(br_if $visit (i32.lt_u (local.get $j) (i32.const 6))))
(local.set $round (i32.add (local.get $round) (i32.const 1)))
(br_if $sweeps (i32.lt_u (local.get $round) (i32.const 67))))
(local.get $s5) ))
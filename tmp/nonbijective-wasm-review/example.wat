nst -1) (local.get $x)) (local.get $x)) (local.get $x)) (local.get $y)))))
     (local.set $nt (i32.sub (local.get $t) (i32.add (i32.add (i32.add (i32.add (i32.add (i32.add (i32.add (i32.add (i32.add (i32.add (i32.add (i32.add (i32.add (i32.add (i32.add (i32.add (i32.add (i32.const 0) (i32.mul (i32.const 1) (local.get $t))) (i32.mul (i32.mul (i32.const 1) (local.get $z)) (local.get $t))) (i32.mul (i32.mul (i32.mul (i32.const 1) (local.get $z)) (local.get $t)) (local.get $t))) (i32.mul (i32.mul (i32.const -1) (local.get $y)) (local.get $t))) (i32.mul (i32.mul (i32.mul (i32.const -1) (local.get $y)) (local.get $t)) (local.get $t))) (i32.mul (i32.mul (i32.const -1) (local.get $x)) (local.get $t))) (i32.mul (i32.mul (i32.mul (i32.const -1) (local.get $x)) (local.get $t)) (local.get $t))) (i32.mul (i32.mul (i32.const -1) (local.get $x)) (local.get $y))) (i32.mul (i32.mul (i32.mul (i32.const -1) (local.get $x)) (local.get $y)) (local.get $z))) (i32.mul (i32.mul (i32.mul (i32.mul (i32.const -2) (local.get $x)) (local.get $y)) (local.get $z)) (local.get $t))) (i32.mul (i32.mul (i32.mul (i32.const 1) (local.get $x)) (local.get $y)) (local.get $y))) (i32.mul (i32.mul (i32.mul (i32.mul (i32.const 2) (local.get $x)) (local.get $y)) (local.get $y)) (local.get $t))) (i32.mul (i32.mul (i32.mul (i32.const 1) (local.get $x)) (local.get $x)) (local.get $y))) (i32.mul (i32.mul (i32.mul (i32.mul (i32.const 2) (local.get $x)) (local.get $x)) (local.get $y)) (local.get $t))) (i32.mul (i32.mul (i32.mul (i32.mul (i32.mul (i32.const 1) (local.get $x)) (local.get $x)) (local.get $y)) (local.get $y)) (local.get $z))) (i32.mul (i32.mul (i32.mul (i32.mul (i32.mul (i32.const -1) (local.get $x)) (local.get $x)) (local.get $y)) (local.get $y)) (local.get $y))) (i32.mul (i32.mul (i32.mul (i32.mul (i32.mul (i32.const -1) (local.get $x)) (local.get $x)) (local.get $x)) (local.get $y)) (local.get $y)))))

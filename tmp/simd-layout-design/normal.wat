(module
(func (export "run") (param $a i32) (param $b i32) (param $c i32) (param $d i32) (param $u i32)
(result i32 i32 i32 i32) (local $v v128) (local $k i32) (local $h i32) (local $t i32)
(local.set $k (i32.and (local.get $u) (i32.const 15)))
(local.set $h (i32.and (i32.shr_u (local.get $u) (i32.const 4)) (i32.const 7)))
(local.set $t (i32.and (i32.shr_u (local.get $u) (i32.const 7)) (i32.const 3)))
(local.set $v (v128.const i32x4 0 0 0 0))
(local.set $v (i32x4.replace_lane 0 (local.get $v) (local.get $a)))
(local.set $v (i32x4.replace_lane 1 (local.get $v) (local.get $b)))
(local.set $v (i32x4.replace_lane 2 (local.get $v) (local.get $c)))
(local.set $v (i32x4.replace_lane 3 (local.get $v) (local.get $d)))
(local.set $v (i16x8.extadd_pairwise_i8x16_u (local.get $v)))
(local.set $v (i16x8.add (i16x8.mul (local.get $v) (local.get $v)) (i16x8.splat (i32.const 37))))
(local.set $v (i32x4.extadd_pairwise_i16x8_u (local.get $v)))
(i32x4.extract_lane 0 (local.get $v))
(i32x4.extract_lane 1 (local.get $v))
(i32x4.extract_lane 2 (local.get $v))
(i32x4.extract_lane 3 (local.get $v))
))
